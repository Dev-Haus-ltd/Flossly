{
	"info": {
		"_postman_id": "admin-api-collection-2026",
		"name": "Admin APIs",
		"description": "Admin portal API endpoints for managing users and viewing system data. All endpoints require admin privileges (roleId = 17).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login (Regular - Admin User)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.token) {",
									"        pm.cookies.set('accessToken', jsonData.data.token);",
									"        pm.environment.set('admin_token', jsonData.data.token);",
									"        console.log('✅ Admin token saved');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"your-password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "Login with admin credentials (roleId = 17). Token will have isAdmin: true flag."
					},
					"response": []
				}
			]
		},
